{
  "manifest_version": 3,
  "name": "Live Try-On: thử đồ trực tiếp",
  "short_name": "Live Try-On",
  "version": "0.1.0",
  "description": "Thử quần áo từ bất kỳ shop nào trực tiếp qua camera: rê chuột lên ảnh rồi bấm \"Thử đồ\", hoặc kéo ảnh vào cửa sổ thử đồ.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Live Try-On"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}