# ─── Realtime try-on provider ────────────────────────────────────────────
# "decart" = real Lucy VTON (needs DECART_API_KEY) · "mock" = free UI testing
VTON_PROVIDER=mock
DECART_API_KEY=
# Model id. lucy-vton-latest currently resolves to lucy-vton-3.6 (1280x720, 30 fps)
DECART_MODEL=lucy-vton-latest
# "fast" = lower latency but billed at 2x. Leave empty for standard.
DECART_SPEED=

# ─── Limits (cost control) ───────────────────────────────────────────────
# No budget yet (decision D5/D6): short sessions, few per day, and a demo code
# so only you / testers / judges can spend Decart credits.
# Hard cap per realtime session, enforced by Decart through the client token.
MAX_SESSION_SECONDS=30
# Sessions per IP per day (in-memory; resets when the server restarts).
FREE_SESSIONS_PER_DAY=3
# When set, real sessions require this code (entered once in the studio).
DEMO_ACCESS_CODE=
# Comma-separated origins allowed to use minted tokens, e.g. https://tryon.example.com
# Leave empty during local development.
TOKEN_ALLOWED_ORIGINS=

# ─── Vision LLM for prompt generation (any OpenAI-compatible endpoint) ───
# Default (decision D3, no budget): Gemini free tier, key from https://aistudio.google.com
#   pick a free-tier "Flash" model listed in AI Studio and put its id in LLM_MODEL.
# Paid alternative: OpenAI https://api.openai.com/v1 with gpt-4o-mini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# ─── Optional: garment extraction from model photos (fal.ai, paid) ───────
# Off while there is no budget (D4): use product shots without a model instead.
FAL_KEY=
